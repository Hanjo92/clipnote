{
  "manifest_version": 3,
  "name": "clipnote",
  "version": "0.1.1",
  "minimum_chrome_version": "127",
  "description": "Save the current tab into clipnote via local server",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "key": "",
  "permissions": ["activeTab", "contextMenus", "notifications", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "clipnote",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    },
    "default_popup": "popup.html"
  }
}
