{
  "manifest_version": 3,
  "name": "clipnote",
  "version": "0.1.0",
  "description": "Save the current tab into clipnote via local server",
  "key": "",
  "permissions": ["tabs", "contextMenus", "notifications", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "clipnote",
    "default_popup": "popup.html"
  }
}
